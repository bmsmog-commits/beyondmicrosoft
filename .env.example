# BMS AI — copy to `.env` for local `netlify dev`. Placeholders only; never
# commit real values. In production, set these in Netlify:
# Site configuration → Environment variables.

# Required. Server-side only (read by netlify/functions/bms-ai.mjs).
# Do NOT prefix with VITE_ — that would expose it to the browser.
AI_API_KEY=your_api_key_here

# Optional. Defaults shown.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5

# Optional. Extra comma-separated origins allowed to call the endpoint, in
# addition to the site's own host (e.g. a second custom domain).
# AI_ALLOWED_ORIGINS=https://www.beyondmicrosoft.com
