# BMS AI — copy to `.env` for local `netlify dev`. Placeholders only; never
# commit real values. In production, set these in Netlify:
# Site configuration → Environment variables.

# Required. Server-side only (read by netlify/functions/bms-ai.mjs).
# Do NOT prefix with VITE_ — that would expose it to the browser.
AI_API_KEY=your_api_key_here

# Optional. Defaults shown.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5

# Optional. Extra comma-separated origins allowed to call the endpoint, in
# addition to the site's own host (e.g. a second custom domain).
# AI_ALLOWED_ORIGINS=https://www.beyondmicrosoft.com

# Phase 5 — project inquiries (netlify/functions/bms-lead.mjs). Optional.
# Default: deployed sites store inquiries in Netlify Forms ("project-inquiry");
# `netlify dev` only validates and logs (nothing is stored or sent).
# LEAD_DELIVERY=netlify-forms   # or: log
# Future automation variables (n8n, Brevo, CRM, WhatsApp, email) are listed in
# docs/BMS-AI.md. None are used yet — do not add them until that work is done.
